{
  "name": "adoptme",
  "version": "1.0.0",
  "description": "API REST de adopción de mascotas - Entrega Final Coderhouse Backend III",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --coverage",
    "test:verbose": "jest --forceExit --verbose --coverage",
    "test:watch": "jest --watch --forceExit"
  },
  "keywords": ["nodejs", "express", "mongoose", "docker", "coderhouse"],
  "author": "Barclay Leach",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "collectCoverageFrom": [
      "src/controllers/adoptions.controller.js",
      "src/routes/adoption.router.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
